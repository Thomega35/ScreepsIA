{
  "compilerOptions": {
    "module": "esnext",
    "lib": ["es2019"],
    "target": "es2019",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "src",
    "paths": { "*": ["./src/*"] },
    "types": ["screeps", "node"],
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "experimentalDecorators": true,
    "noImplicitReturns": true,
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false
  },
  "exclude": [
    "node_modules"
  ]
}
